VPC Create terraform

#VPC
#subnet
#IGW
#Route table 
resource "aws_vpc" "terravpc" {
  cidr_block = "10.0.0.0/20"
  tags = {
    Name = "Terra-VPC"
  }
}
resource "aws_subnet" "public_subnet_1" {
  vpc_id = aws_vpc.terravpc.id
  cidr_block = "10.0.1.0/24"
  availability_zone = "us-west-2a"
  map_public_ip_on_launch = true
  tags = {
    Name = "Terra_public_subnet_1"
  }  
}
resource "aws_subnet" "public_subnet_2" {
  vpc_id = aws_vpc.terravpc.id
  cidr_block = "10.0.2.0/24"
  availability_zone = "us-west-2b"
  map_public_ip_on_launch = true
  tags = {
    Name = "Terra_public_subnet_2"
  }  
}
resource "aws_subnet" "private_subnet_1" {
  vpc_id = aws_vpc.terravpc.id
  cidr_block = "10.0.3.0/24"
  availability_zone = "us-west-2a"
  tags = {
    Name = "Terra_private_subnet_1"
  }  
}
resource "aws_internet_gateway" "terra_igw" {
  vpc_id = aws_vpc.terravpc.id
  tags = {
    Name = "Terra_IGW"
  }    
}
resource "aws_route_table" "terra_rt_1" {
  vpc_id = aws_vpc.terravpc.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.terra_igw.id
  }  
  tags = {
    Name = "Terra_RT_1"
  } 
 
}
resource "aws_route_table_association" "rt_association_1" {
  route_table_id = aws_route_table.terra_rt_1.id
  subnet_id = aws_subnet.public_subnet_1.id  
}
resource "aws_route_table_association" "rt_association_2" {
  route_table_id = aws_route_table.terra_rt_1.id
  subnet_id = aws_subnet.public_subnet_2.id  
}
